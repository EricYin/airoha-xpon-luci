#!/bin/sh
# 每个 multicast_vlan section 对应一个驱动 M-VLAN；完整重放避免残留。
IGMP=/userfs/bin/xponigmpcmd
LOG=/tmp/pon-multicast.log

valid_vid() { [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 4094 ] 2>/dev/null; }
run() { echo "+ $*" >>"$LOG"; timeout 3 "$@" >>"$LOG" 2>&1; }
select_port() { run "$IGMP" port index "$1"; }

find_section() {
	[ "$(uci -q get "pon.mvlan_$1")" = "multicast_vlan" ] && { echo "mvlan_$1"; return; }
	i=0
	while uci -q get "pon.@multicast_vlan[$i]" >/dev/null; do
		[ "$(uci -q get "pon.@multicast_vlan[$i].vlan_id")" = "$1" ] && { echo "@multicast_vlan[$i]"; return; }
		i=$((i + 1))
	done
}

list_sections() {
	uci -q show pon 2>/dev/null | sed -n 's/^pon\.\([^.=]*\)=multicast_vlan$/\1/p'
}

apply_one() {
	s=$1
	vid=$(uci -q get "pon.$s.vlan_id") || return 1
	interface_vid=$(uci -q get "pon.$s.interface_vid"); interface_vid=${interface_vid:-$vid}
	bound=$(uci -q get "pon.$s.bound"); bound=${bound:-0}
	port=$(uci -q get "pon.$s.port"); port=${port:-1}
	ver=$(uci -q get "pon.$s.igmp_version"); ver=${ver:-2}
	valid_vid "$vid" || return 2
	run "$IGMP" mvlan add "$vid" || return $?
	select_port "$port" || return $?
	run "$IGMP" port ver "$ver" || return $?
	if [ "$bound" = "1" ]; then
		run "$IGMP" port func 1 || return $?
		run "$IGMP" port vlan add "$interface_vid" || return $?
	else
		run "$IGMP" port vlan del "$interface_vid"
	fi
}

status() {
	# 配置与驱动状态由同一个 helper 输出，避免 LuCI CGI 中二次读取 UCI
	# 失败后把已配置 M-VLAN 错判成“已注册未绑定”。
	for s in $(list_sections); do
		vid=$(uci -q get "pon.$s.vlan_id")
		interface_vid=$(uci -q get "pon.$s.interface_vid"); interface_vid=${interface_vid:-$vid}
		bound=$(uci -q get "pon.$s.bound"); bound=${bound:-0}
		port=$(uci -q get "pon.$s.port"); port=${port:-1}
		valid_vid "$vid" && echo "config=$vid,$interface_vid,$bound,$port"
	done
	timeout 3 "$IGMP" mvlan show 2>/dev/null | awk '$2 ~ /^[0-9]+$/ {print "mvlan=" $2}'
	for port in 1 2 3 4; do
		timeout 3 "$IGMP" port index "$port" >/dev/null 2>&1
		timeout 3 "$IGMP" port vlan show 2>/dev/null | awk -v p="$port" '$2 ~ /^[0-9]+$/ {print "binding=" p "," $2}'
	done
}

case "$1" in
	status) status ;;
	add)
		vid=$2; interface_vid=$3; port=${4:-1}; ver=${5:-2}; valid_vid "$vid" || exit 2
		valid_vid "$interface_vid" || exit 2
		[ -z "$(find_section "$vid")" ] || exit 3
		s="mvlan_$vid"
		uci set "pon.$s=multicast_vlan" || exit 1
		uci set "pon.$s.vlan_id=$vid"; uci set "pon.$s.bound=1"
		uci set "pon.$s.interface_vid=$interface_vid"
		uci set "pon.$s.port=$port"; uci set "pon.$s.igmp_version=$ver"; uci commit pon
		: >"$LOG"
		apply_one "$s"
		rc=$?
		if [ "$rc" -ne 0 ]; then
			uci delete "pon.$s"; uci commit pon; exit "$rc"
		fi
		;;
	bind)
		vid=$2; val=$3; s=$(find_section "$vid"); [ -n "$s" ] || exit 4
		interface_vid=$(uci -q get "pon.$s.interface_vid"); interface_vid=${interface_vid:-$vid}
		port=$(uci -q get "pon.$s.port"); port=${port:-1}; select_port "$port" || exit $?
		if [ "$val" = 1 ]; then
			run "$IGMP" port func 1 && run "$IGMP" port vlan add "$interface_vid" || exit $?
		else
			run "$IGMP" port vlan del "$interface_vid" || exit $?
		fi
		uci set "pon.$s.bound=$val"; uci commit pon
		;;
	delete)
		vid=$2; s=$(find_section "$vid")
		interface_vid=$(uci -q get "pon.$s.interface_vid"); interface_vid=${interface_vid:-$vid}
		port=$(uci -q get "pon.$s.port"); port=${port:-1}; select_port "$port"
		run "$IGMP" port vlan del "$interface_vid"; run "$IGMP" mvlan del "$vid" || exit $?
		[ -n "$s" ] && { uci delete "pon.$s"; uci commit pon; }
		;;
	apply-all)
		: >"$LOG"
		for s in $(list_sections); do
			apply_one "$s" || exit $?
		done
		;;
	*) echo "usage: $0 {status|add MVID INTERFACE_VID [PORT VER]|bind MVID 0|1|delete MVID|apply-all}" >&2; exit 2 ;;
esac
