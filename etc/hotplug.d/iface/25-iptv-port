#!/bin/sh
# 可选“IPTV 专口透传”：仅当 xpon.iptv.stb_port 非空时生效。
#
# 模型：STB 自带 3169 标签 PPPoE/IPoE 拨号
#   STB <--tagged--> br-iptv <--tagged--> pon.<vlan>
# 步骤：
#   1) 把指定 LAN 口从 br-lan 摘出（防 IPTV 广播扩散到其他 LAN 口/风暴）
#   2) 建 br-iptv 桥，只放该 LAN 口 + pon.<vlan>
# 若不确定 OLT/装维的透传方式，保持 stb_port 为空（IPTV 走路由拨号 + IGMP）。

[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "iptv" ] || exit 0
[ -f /etc/config/xpon ] || exit 0

port=$(uci -q get xpon.iptv.stb_port)
[ -n "$port" ] || exit 0
vid=$(uci -q get xpon.iptv.vlan)
[ -n "$vid" ] || exit 0

case "$port" in
	eth0.*) lan_if=$port ;;
	lan1)   lan_if=eth0.4 ;;
	lan2)   lan_if=eth0.5 ;;
	lan3)   lan_if=eth0.6 ;;
	lan4)   lan_if=eth0.7 ;;
	*)      lan_if= ;;
esac
[ -n "$lan_if" ] || exit 0
[ -d "/sys/class/net/$lan_if" ] || exit 0
[ -d "/sys/class/net/pon.$vid" ] || exit 0

brctl delif br-lan "$lan_if" 2>/dev/null
brctl addbr br-iptv 2>/dev/null
brctl delif br-iptv "$lan_if" 2>/dev/null
brctl delif br-iptv "pon.$vid" 2>/dev/null
brctl addif br-iptv "$lan_if"
brctl addif br-iptv "pon.$vid"
ip link set "$lan_if" up
ip link set "pon.$vid" up

logger -t xpon-iptv "IPTV port pass-through: $lan_if <-> pon.$vid"
exit 0
