#!/bin/sh
# xpon-luci 首次安装/升级兜底（uci-defaults 只跑一次，随后自删）

# 0) /etc/config/pon 缺失时创建；升级包不携带该文件，避免覆盖用户的组播 VLAN。
P=/etc/config/pon
if [ ! -f "$P" ]; then
	cat > "$P" <<'EOF'
config multicast 'multicast'
	option enabled '0'
	option vlan_id ''
	option igmp_version '2'
	option port '1'
	option snooping '1'
	option proxy '0'
	option proxy_port '1'
EOF
fi

# 1) /etc/config/xpon 缺失时重建（防误删后 LuCI 报错）
X=/etc/config/xpon
if [ ! -f "$X" ]; then
	cat > "$X" <<'EOF'
config auth 'device'
	option vendor_id ''
	option equipment_id ''
	option onu_version ''
	option omcc_version ''
	option pon_mac ''
	option auth_type_g 'LOID'
	option loid ''
	option loid_password ''
	option def_sn ''
	option sn ''
	option xpon_sn_auth_type 'ascii'
	option sn_regid_password ''
	option epon_oui ''
	option epon_ven_info ''

config service 'tr069'
	option enable '0'
	option vlan '3600'
	option pbit '7'
	option mtu '1500'
	option proto 'static'

config service 'internet'
	option enable '1'
	option vlan '466'
	option pbit '0'
	option mtu '1492'
	option proto 'pppoe'
	option ip6proto 'dhcpv6'

config service 'iptv'
	option enable '1'
	option vlan '3169'
	option mcast_vlan '3799'
	option pbit '4'
	option mtu '1500'
	option proto 'ipoe'
	option igmp 'snooping'
	option igmp_version '2'
	option iptv_port ''
	option igmp_fastleave '1'

config service 'voice'
	option enable '1'
	option vlan '3040'
	option pbit '0'
	option mtu '1500'
	option proto 'static'
	option metric '10'

config led 'behaviour'
	option fix_sts_green '1'

config fallback 'rules'
	option enable '0'
	option gem_base '10'
EOF
fi

# 2) 确保 network.xpon_auth 存在（S00xponconfig 也会建，这里只补缺省键、不覆盖已有值）
factory_sn=$(sed -n "s/^fsan='\(.*\)'/\1/p" /tmp/dsd.env 2>/dev/null | head -1)
[ "${#factory_sn}" -eq 12 ] || factory_sn=NoNumber
uci -q get network.xpon_auth >/dev/null || uci set network.xpon_auth='xpon_auth'
uci -q get network.xpon_auth.pon_mode >/dev/null || uci set network.xpon_auth.pon_mode='GPON'
if ! uci -q get network.xpon_auth.pon_tech >/dev/null; then
	# 缺省 PON 技术按当前 onu_type bits[7:4] 推导，避免把 XGPON 设备默认成 GPON
	pt=GPON
	ch=$(grep -o 'onu_type=[0-9a-fA-F]' /proc/cmdline 2>/dev/null | head -1 | cut -d= -f2)
	case "$ch" in
		3) pt=EPON_10G_1G ;;
		4) pt=EPON_10G_10G ;;
		6) pt=XGPON ;;
		7) pt=XGSPON ;;
	esac
	uci set network.xpon_auth.pon_tech="$pt"
fi
uci -q get network.xpon_auth.auth_type_g >/dev/null || uci set network.xpon_auth.auth_type_g='LOID'
uci -q get network.xpon_auth.xpon_sn_auth_type >/dev/null || uci set network.xpon_auth.xpon_sn_auth_type='ascii'
uci -q get network.xpon_auth.sn >/dev/null || uci set network.xpon_auth.sn="$factory_sn"
uci -q get network.xpon_auth.def_sn >/dev/null || uci set network.xpon_auth.def_sn="$factory_sn"
uci -q get network.xpon_auth.loid >/dev/null || uci set network.xpon_auth.loid=''
uci -q get network.xpon_auth.loid_password >/dev/null || uci set network.xpon_auth.loid_password=''
uci commit network

# 3) xpon.device 认证持久源（restore-auth 开机回写 network.xpon_auth 的依据）。
#    旧包升级时补齐缺省键；用户经 LuCI 认证页保存后这些值会被覆盖为实际选择。
uci -q get xpon.device >/dev/null || uci set xpon.device='auth'
uci -q get xpon.device.pon_tech >/dev/null || uci set xpon.device.pon_tech="$(uci -q get network.xpon_auth.pon_tech)"
uci -q get xpon.device.auth_type_g >/dev/null || uci set xpon.device.auth_type_g='LOID'
factory_vendor=${factory_sn%????????}
[ "${#factory_vendor}" -eq 4 ] || factory_vendor=
[ -n "$(uci -q get xpon.device.vendor_id)" ] || [ -z "$factory_vendor" ] || uci set xpon.device.vendor_id="$factory_vendor"
uci -q get xpon.device.loid >/dev/null || uci set xpon.device.loid=''
uci -q get xpon.device.loid_password >/dev/null || uci set xpon.device.loid_password=''
uci -q get xpon.device.def_sn >/dev/null || uci set xpon.device.def_sn=''
uci -q get xpon.device.sn >/dev/null || uci set xpon.device.sn=''
uci -q get xpon.device.xpon_sn_auth_type >/dev/null || uci set xpon.device.xpon_sn_auth_type='ascii'
uci -q get xpon.device.sn_regid_password >/dev/null || uci set xpon.device.sn_regid_password=''
uci -q get xpon.device.epon_oui >/dev/null || uci set xpon.device.epon_oui=''
uci -q get xpon.device.epon_ven_info >/dev/null || uci set xpon.device.epon_ven_info=''
uci commit xpon

uci -q get pon.multicast >/dev/null || uci set pon.multicast='multicast'
uci -q get pon.multicast.snooping >/dev/null || uci set pon.multicast.snooping='1'
uci -q get pon.multicast.proxy >/dev/null || uci set pon.multicast.proxy='0'
uci -q get pon.multicast.proxy_port >/dev/null || uci set pon.multicast.proxy_port="$(uci -q show pon 2>/dev/null | sed -n "s/^pon\.[^.=]*\.port='\([1-4]\)'$/\1/p" | head -1)"
[ -n "$(uci -q get pon.multicast.proxy_port)" ] || uci set pon.multicast.proxy_port='1'
uci commit pon

# 专用 init 脚本持久重放驱动组播配置；不修改 rc.local，避免重复执行。
# 原厂 S99uenv_update 会修改 env 后重启。保留 init 文件供 S96bootloader
# 检查，无条件移除自动启动链接，避免不同版本的脚本绕过内容匹配。
rm -f /etc/rc.d/S99uenv_update /etc/rc.d/K99uenv_update
[ -x /etc/init.d/pon-services ] && /etc/init.d/pon-services enable
[ -x /etc/init.d/xpon-app ] && /etc/init.d/xpon-app enable

exit 0
