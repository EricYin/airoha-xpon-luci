#!/bin/sh /etc/rc.common
# xpon-luci 启动兼容与运行态重放（在 S00xponconfig 之后）：
#   * 新版 S00 已直接采用持久认证；旧版 S00 或主路径失败时在此兜底
#   * OMCI/OAM 就绪后重放厂商信息和 PON MAC
#   * LED 修复（sts_green 常亮 / 上网灯触发器）
#   * 可选：规则守护进程（xpon.fallback.enable=1 时启动）
START=11
STOP=89

disable_factory_uenv_autostart() {
	# 保留 init 文件供 S96bootloader 的存在性检查，但绝不允许启动时修改 env
	# 或重启。无条件删除链接，兼容已被修改而不再含 fw_setenv onu_type 的版本。
	if [ -e /etc/rc.d/S99uenv_update ] || [ -L /etc/rc.d/S99uenv_update ] ||
	   [ -e /etc/rc.d/K99uenv_update ] || [ -L /etc/rc.d/K99uenv_update ]; then
		rm -f /etc/rc.d/S99uenv_update /etc/rc.d/K99uenv_update
		logger -t xpon "已禁用原厂 uenv_update 自动启动，避免 env 回写重启循环"
	fi
}

normalize_pppoe_names() {
	local meta iface vid expected current changed=0

	# Upgrade existing managed services before S20network starts. Without an
	# explicit pppname, netifd builds pppoe-xpon_<key>, which may be truncated
	# by Linux and leave the logical interface permanently pending.
	for meta in $(uci show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)=xpon_service$/\1/p"); do
		[ "$(uci -q get "network.$meta.xpon_managed")" = 1 ] || continue
		iface=$(uci -q get "network.$meta.interface")
		vid=$(uci -q get "network.$meta.vlan_id")
		case "$vid" in ''|*[!0-9]*) continue ;; esac
		[ "$vid" -ge 1 ] 2>/dev/null && [ "$vid" -le 4094 ] 2>/dev/null || continue
		[ -n "$iface" ] || continue
		[ "$(uci -q get "network.$iface.xpon_managed")" = 1 ] || continue
		[ "$(uci -q get "network.$iface.proto")" = pppoe ] || continue
		expected="pppoe-pon$vid"
		current=$(uci -q get "network.$iface.pppname")
		[ "$current" = "$expected" ] && continue
		uci set "network.$iface.pppname=$expected" || continue
		changed=1
	done
	[ "$changed" = 0 ] || uci commit network
}

normalize_default_lan_bridge() {
	local brsec current item kept changed=0

	# Upgrades preserve /overlay/etc/config/network, so devices flashed from an
	# older image can still have eth0.5/7/8 in br-lan even when the new squashfs
	# default only contains eth0.4. Remove the SerDes/HSGMII subports before
	# S20network starts; they can be re-enabled explicitly for experiments with
	# network.globals.hsgmii_autobridge=1.
	[ "$(uci -q get network.globals.hsgmii_autobridge)" = "1" ] && return 0

	for brsec in $(uci show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)=device$/\1/p"); do
		[ "$(uci -q get "network.$brsec.type")" = bridge ] || continue
		[ "$(uci -q get "network.$brsec.name")" = br-lan ] && break
		brsec=
	done
	[ -n "$brsec" ] || return 0

	current=$(uci -q get "network.$brsec.ports")
	kept=
	for item in $current; do
		case "$item" in
			eth0.5|eth0.7|eth0.8) changed=1 ;;
			*) kept="$kept $item" ;;
		esac
	done
	[ "$changed" = 1 ] || return 0

	uci -q delete "network.$brsec.ports"
	for item in $kept; do uci add_list "network.$brsec.ports=$item"; done
	uci commit network
	logger -t xpon "已从旧 br-lan 持久配置移除 eth0.5/7/8，避免 eth0 启动循环"
}

normalize_managed_lan_ports() {
	local meta port dev brsec current item kept changed=0
	local managed=" "

	# Upgrade configurations written by older releases before S20network reads
	# them. A physical port must belong to either br-lan or an Access bridge,
	# never both. Runtime brctl changes race netifd and can restart eth0 forever.
	for meta in $(uci show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)=xpon_service$/\1/p"); do
		[ "$(uci -q get "network.$meta.xpon_managed")" = 1 ] || continue
		[ "$(uci -q get "network.$meta.enable")" = 1 ] || continue
		[ "$(uci -q get "network.$meta.mode")" = bridged ] || continue
		port=$(uci -q get "network.$meta.lan_port")
		case "$port" in
			lan1) dev=eth0.8 ;;
			lan2) dev=eth0.7 ;;
			lan3) dev=eth0.5 ;;
			lan4) dev=eth0.4 ;;
			*) continue ;;
		esac
		case "$managed" in *" $dev "*) ;; *) managed="$managed$dev " ;; esac
	done
	[ "$managed" != " " ] || return 0

	for brsec in $(uci show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)=device$/\1/p"); do
		[ "$(uci -q get "network.$brsec.type")" = bridge ] || continue
		[ "$(uci -q get "network.$brsec.name")" = br-lan ] && break
		brsec=
	done
	[ -n "$brsec" ] || return 0

	current=$(uci -q get "network.$brsec.ports")
	kept=
	for item in $current; do
		case "$managed" in
			*" $item "*) changed=1 ;;
			*) kept="$kept $item" ;;
		esac
	done
	[ "$changed" = 1 ] || return 0

	uci -q delete "network.$brsec.ports"
	for item in $kept; do uci add_list "network.$brsec.ports=$item"; done
	uci commit network
	logger -t xpon "已从 br-lan 持久配置移除受管端口，避免 netifd 桥成员循环"
}

refresh_epon_status() {
	local mode tmp=/tmp/epon_reg_auth_status.$$
	while true; do
		mode=$(cat /proc/tc3162/sys_xpon_mode 2>/dev/null)
		case "$mode" in
			2|3|4|5|12)
				if timeout 3 /userfs/bin/ponmgr epon get llid_info >"$tmp" 2>/dev/null &&
				   [ -s "$tmp" ]; then
					mv -f "$tmp" /tmp/epon_reg_auth_status
				else
					printf 'LLID = N/A\n' >"$tmp"
					mv -f "$tmp" /tmp/epon_reg_auth_status
				fi
				;;
			*)
				rm -f "$tmp" /tmp/epon_reg_auth_status
				;;
		esac
		sleep 30
	done
}

start_epon_status_refresher() {
	local pid
	pid=$(cat /var/run/xpon-epon-status.pid 2>/dev/null)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
	refresh_epon_status >/dev/null 2>&1 &
	echo $! >/var/run/xpon-epon-status.pid
}

start() {
	disable_factory_uenv_autostart
	normalize_default_lan_bridge
	[ -f /etc/config/xpon ] || [ ! -x /etc/uci-defaults/zzz-xpon ] || /etc/uci-defaults/zzz-xpon
	[ -f /etc/config/xpon ] || return 0
	normalize_managed_lan_ports
	normalize_pppoe_names
	# preinit 未能读取 DSD 时再补建一次。
	[ -s /tmp/dsd.env ] || /usr/bin/xpon-dsd-env.sh
	# 新版 S00 会在 S20network 前恢复认证并留下标记；没有标记说明仍是
	# 旧版原厂脚本，或主路径失败，需要维持原有兼容兜底。
	if [ ! -e /tmp/.xponconfig-persistent-auth ]; then
		/usr/bin/xpon-apply.sh restore-auth || logger -t xpon "兼容认证恢复失败；将继续等待引擎并尝试设备层重放"
	else
		logger -t xpon "S00 已恢复持久认证，跳过 S11 兼容覆盖"
	fi
	/usr/bin/xpon-apply.sh leds
	# vendor_id/equipment_id/onu_version 等只存在共享内存，必须等 OMCI 启动后重放。
	/usr/bin/xpon-replay.sh >/dev/null 2>&1 &
	# GPON OMCI shared-memory identity may be reset after the first replay.
	# Track omci restarts and repair SN/Vendor ID drift in-place.
	/usr/bin/xpon-gpon-identity-watch.sh watch 5 >/dev/null 2>&1 &
	# netifd/vendor control paths may restart epon_oam again after the initial
	# replay. Track process changes and restore the complete OAM identity.
	/usr/bin/xpon-epon-sn.sh watch 5 >/dev/null 2>&1 &
	start_epon_status_refresher
	[ "$(uci -q get xpon.fallback.enable)" = "1" ] && /usr/bin/xpon-fallback.sh &
}

stop() {
	status_pid=$(cat /var/run/xpon-epon-status.pid 2>/dev/null)
	[ -n "$status_pid" ] && kill "$status_pid" 2>/dev/null
	rm -f /var/run/xpon-epon-status.pid /tmp/epon_reg_auth_status
	watch_pid=$(cat /var/run/xpon-epon-sn-watch.pid 2>/dev/null)
	[ -n "$watch_pid" ] && kill "$watch_pid" 2>/dev/null
	rm -f /var/run/xpon-epon-sn-watch.pid
	watch_pid=$(cat /var/run/xpon-gpon-identity-watch.pid 2>/dev/null)
	[ -n "$watch_pid" ] && kill "$watch_pid" 2>/dev/null
	rm -f /var/run/xpon-gpon-identity-watch.pid
	killall xpon-fallback.sh 2>/dev/null
	killall xpon-fallback 2>/dev/null
}
