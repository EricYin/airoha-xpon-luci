# xpon-luci 私有配置（认证厂商信息 / 业务模板 / LED / 回退规则）
# 由 LuCI “XG2010G PON” 菜单读写；network.xpon_auth / wan_vlan 由 netifd 引擎原生读取

config auth 'device'
	option vendor_id 'MTKG'
	option equipment_id ''
	option onu_version ''
	option omcc_version '0xA3'
	option pon_mac ''

config service 'tr069'
	option enable '0'
	option vlan '3600'
	option pbit '7'
	option mtu '1500'
	option proto 'static'
	option ipaddr ''
	option netmask ''
	option gateway ''

config service 'internet'
	option enable '1'
	option vlan '466'
	option pbit '0'
	option mtu '1492'
	option proto 'pppoe'
	option username ''
	option password ''
	option ip6proto 'dhcpv6'

config service 'iptv'
	option enable '1'
	option vlan '3169'
	option mcast_vlan '3799'
	option pbit '4'
	option mtu '1500'
	option proto 'ipoe'
	option username ''
	option password ''
	option stb_port ''
	option iptv_port ''
	option igmp 'snooping'
	option igmp_version '2'
	option igmp_fastleave '1'

config service 'voice'
	option enable '1'
	option vlan '3040'
	option pbit '0'
	option mtu '1500'
	option proto 'static'
	option ipaddr '23.50.128.40'
	option netmask '255.255.240.0'
	option gateway '23.50.128.1'
	option metric '10'

config led 'behaviour'
	option fix_sts_green '1'
	option internet_led 'sts_blue'

config fallback 'rules'
	option enable '0'
	option gem_base '10'
